# Server Configuration
PORT=3001
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Choose ONE of the following database types:
# - mysql (recommended for local development)
# - sqlserver (Microsoft SQL Server)

# MySQL Configuration (Recommended)
DB_TYPE=mysql
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=your_mysql_password
MYSQL_DB_NAME=sql_api_builder

# SQL Server Configuration (Alternative)
# DB_TYPE=sqlserver
# APP_DB_SERVER=localhost
# APP_DB_PORT=1433
# APP_DB_NAME=SQLAPIBuilder
# APP_DB_USER=sa
# APP_DB_PASSWORD=YourStrong@Passw0rd
# APP_DB_ENCRYPT=false
# APP_DB_TRUST_CERT=true

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Encryption Key (CHANGE THIS! Must be at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-super-secret-encryption-key-change-in-production-32chars!

# JWT Secret (CHANGE THIS!)
JWT_SECRET=your-jwt-secret-change-this-in-production

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

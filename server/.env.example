# Server Configuration
PORT=3001
NODE_ENV=development

# Application Database (stores users, APIs, logs, etc.)
APP_DB_SERVER=localhost
APP_DB_PORT=1433
APP_DB_NAME=SQLAPIBuilder
APP_DB_USER=sa
APP_DB_PASSWORD=YourStrong@Passw0rd
APP_DB_ENCRYPT=false
APP_DB_TRUST_CERT=true

# Encryption Key (32+ characters, change in production!)
ENCRYPTION_KEY=your-super-secret-encryption-key-change-this-in-production-32chars!

# JWT Secret (for future authentication)
JWT_SECRET=your-jwt-secret-change-this-in-production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
